---
import Layout from '../layouts/Layout.astro';
import InstagramGallery from '../components/InstagramGallery.astro';
---

<Layout title="Underwater Photography">
  <!-- Hero -->
  <section class="relative py-32 overflow-hidden">
    <div class="absolute inset-0">
      <div class="absolute inset-0 bg-gradient-to-b from-neutral-950 via-neutral-900/50 to-neutral-950"></div>
      <img 
        src="https://images.unsplash.com/photo-1682687220742-aba13b6e50ba?w=1920&q=80" 
        alt="Underwater background" 
        class="w-full h-full object-cover opacity-20"
      />
    </div>
    
    <div class="relative z-10 max-w-7xl mx-auto px-6 text-center">
      <span class="inline-block px-4 py-1.5 bg-cyan-500/10 border border-cyan-500/30 text-cyan-400 text-xs tracking-[0.3em] uppercase rounded-full mb-6">
        Portfolio
      </span>
      <h1 class="text-5xl md:text-7xl font-light mb-6">Underwater</h1>
      <p class="text-neutral-400 text-lg max-w-2xl mx-auto leading-relaxed">
        Exploring the mesmerizing world beneath the waves. 
        From vibrant coral reefs to the mysterious depths, 
        capturing the beauty of marine life.
      </p>
      
      <!-- Social Link -->
      <div class="mt-10">
        <a 
          href="https://instagram.com" 
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 text-neutral-500 hover:text-cyan-400 transition-colors"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
          <span class="text-sm tracking-wider">Follow on Instagram</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Gallery -->
  <section class="pb-32">
    <div class="max-w-7xl mx-auto px-6">
      <InstagramGallery type="underwater" columns={4} />
      
      <!-- Note -->
      <div class="mt-16 text-center">
        <p class="text-neutral-600 text-sm">
          Photos loaded from data file. To sync with Instagram: see <code class="px-2 py-1 bg-neutral-800 rounded text-neutral-400">scripts/fetch-instagram.js</code>
        </p>
      </div>
    </div>
  </section>

  <!-- More CTA -->
  <section class="py-20 bg-neutral-900/30 border-y border-white/5">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h3 class="text-2xl font-light mb-4">Dive In With Me</h3>
      <p class="text-neutral-400 mb-8">Available for underwater photography commissions and dive trips.</p>
      <a href="/contact" class="inline-flex items-center gap-2 px-6 py-3 bg-cyan-500 text-neutral-950 text-sm tracking-wider hover:bg-cyan-400 transition-colors">
        Get in Touch
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </section>
</Layout>
