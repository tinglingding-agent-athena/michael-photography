---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home">
  <!-- Hero Section -->
  <section class="relative h-screen flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-neutral-950 via-transparent to-neutral-950 z-10"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-neutral-800/30 via-neutral-950 to-neutral-950"></div>
    
    <!-- Background Image -->
    <div class="absolute inset-0 opacity-40">
      <img 
        src="https://images.unsplash.com/photo-1518837695005-2083093ee35b?w=1920&q=80" 
        alt="Underwater background" 
        class="w-full h-full object-cover"
      />
    </div>
    
    <div class="relative z-20 text-center px-6">
      <p class="text-amber-400 tracking-[0.3em] text-sm mb-4 uppercase">Photography Portfolio</p>
      <h1 class="text-6xl md:text-8xl font-light tracking-wider mb-6">
        Michael
      </h1>
      <p class="text-xl md:text-2xl text-neutral-400 font-light mb-12 max-w-2xl mx-auto">
        Capturing moments through <span class="text-amber-400">portrait</span> and <span class="text-cyan-400">underwater</span> lens
      </p>
      <div class="flex gap-4 justify-center">
        <a href="/portrait" class="px-8 py-3 bg-amber-500 text-neutral-950 tracking-wider text-sm hover:bg-amber-400 transition-colors">
          Portrait
        </a>
        <a href="/underwater" class="px-8 py-3 border border-neutral-600 text-neutral-300 tracking-wider text-sm hover:border-cyan-400 hover:text-cyan-400 transition-colors">
          Underwater
        </a>
      </div>
    </div>
  </section>

  <!-- Featured Sections -->
  <section class="max-w-7xl mx-auto px-6 py-24">
    <div class="grid md:grid-cols-2 gap-12">
      <!-- Portrait Preview -->
      <a href="/portrait" class="group relative aspect-[4/5] overflow-hidden">
        <img 
          src="https://images.unsplash.com/photo-1531746020798-e6953c6e8e04?w=800&q=80" 
          alt="Portrait Photography" 
          class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-neutral-950/80 via-transparent to-transparent"></div>
        <div class="absolute bottom-0 left-0 right-0 p-8">
          <span class="text-amber-400 tracking-widest text-xs uppercase">Portfolio</span>
          <h2 class="text-3xl font-light mt-2">Portrait</h2>
          <p class="text-neutral-400 mt-2">Capturing essence & emotion</p>
        </div>
      </a>
      
      <!-- Underwater Preview -->
      <a href="/underwater" class="group relative aspect-[4/5] overflow-hidden">
        <img 
          src="https://images.unsplash.com/photo-1682687220742-aba13b6e50ba?w=800&q=80" 
          alt="Underwater Photography" 
          class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-neutral-950/80 via-transparent to-transparent"></div>
        <div class="absolute bottom-0 left-0 right-0 p-8">
          <span class="text-cyan-400 tracking-widest text-xs uppercase">Portfolio</span>
          <h2 class="text-3xl font-light mt-2">Underwater</h2>
          <p class="text-neutral-400 mt-2">Exploring the depths</p>
        </div>
      </a>
    </div>
  </section>

  <!-- About Teaser -->
  <section class="bg-neutral-900 py-24">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <p class="text-neutral-500 tracking-widest text-xs uppercase mb-4">About Me</p>
      <h2 class="text-4xl font-light mb-8">The Photographer Behind the Lens</h2>
      <p class="text-neutral-400 leading-relaxed mb-8">
        With a passion for capturing raw emotion and the mysteries of the deep, 
        I specialize in portrait and underwater photography. Each shot tells a story, 
        each frame preserves a moment in time.
      </p>
      <a href="/about" class="inline-block border-b border-amber-400 text-amber-400 pb-1 tracking-wider text-sm hover:text-white transition-colors">
        Learn More
      </a>
    </div>
  </section>

  <!-- Contact CTA -->
  <section class="py-24">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <p class="text-neutral-500 tracking-widest text-xs uppercase mb-4">Get in Touch</p>
      <h2 class="text-4xl font-light mb-8">Let's Create Together</h2>
      <p class="text-neutral-400 leading-relaxed mb-8">
        Interested in working together or purchasing prints? I'd love to hear from you.
      </p>
      <a href="/contact" class="px-8 py-3 bg-neutral-100 text-neutral-950 tracking-wider text-sm hover:bg-amber-400 transition-colors">
        Contact Me
      </a>
    </div>
  </section>
</Layout>
